  <GVL Name="GVL_Vision" Id="{a1f2b3c4-0001-4e00-9000-c0ffee000001}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'linkalways'}
VAR_GLOBAL
    // Written by the vision PC over ADS.
    nHeartbeat : UDINT;             // increments ~1/s while the vision app runs
